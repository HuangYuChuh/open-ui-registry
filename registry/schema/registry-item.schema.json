{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ui-registry.example/schema/registry-item.schema.json",
  "title": "Open UI Registry Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "title",
    "description",
    "status",
    "classification",
    "runtime",
    "files",
    "dependencies",
    "provenance",
    "license",
    "quality"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "verified", "deprecated"]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "subcategory", "domains", "patterns"],
      "properties": {
        "category": {
          "enum": [
            "layout",
            "navigation",
            "input",
            "data-display",
            "feedback",
            "overlay",
            "media",
            "motion",
            "utility"
          ]
        },
        "subcategory": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "language", "styling", "clientComponent", "ssrCompatible"],
      "properties": {
        "framework": {
          "const": "react"
        },
        "language": {
          "const": "typescript"
        },
        "styling": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "clientComponent": {
          "type": "boolean"
        },
        "ssrCompatible": {
          "type": "boolean"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": ["component", "style", "hook", "utility", "demo", "test", "license", "notice"]
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npm", "registry"],
      "properties": {
        "npm": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "registry": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "demoUrl", "sourceUrl", "retrievedAt", "modified", "modifications"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "demoUrl": {
          "type": "string",
          "format": "uri"
        },
        "repositoryUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "upstreamVersion": {
          "type": "string"
        },
        "upstreamCommit": {
          "type": "string"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date"
        },
        "modified": {
          "type": "boolean"
        },
        "modifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "redistributionReviewed"],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "noticeFile": {
          "type": "string"
        },
        "redistributionReviewed": {
          "type": "boolean"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typecheck", "build", "preview", "responsive", "accessibility", "darkMode"],
      "properties": {
        "typecheck": {
          "type": "boolean"
        },
        "build": {
          "type": "boolean"
        },
        "preview": {
          "type": "boolean"
        },
        "responsive": {
          "type": "boolean"
        },
        "accessibility": {
          "type": "boolean"
        },
        "darkMode": {
          "type": "boolean"
        },
        "visualRegression": {
          "type": "boolean"
        }
      }
    }
  }
}
