{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ui-registry.example/schema/registry-index.schema.json",
  "title": "Open UI Registry Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "items"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "./registry-item.schema.json"
      }
    }
  }
}
